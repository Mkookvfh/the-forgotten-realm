diff -ruN '--exclude=screenshots' '--exclude=*.patch' the-forgotten-realm-0.7/src/vegetation/grass-generator.js the-forgotten-realm-0.8/src/vegetation/grass-generator.js
--- the-forgotten-realm-0.7/src/vegetation/grass-generator.js	1970-01-01 00:00:00.000000000 +0000
+++ the-forgotten-realm-0.8/src/vegetation/grass-generator.js	2026-11-23 11:23:44.718924290 +0000
@@ -0,0 +1,214 @@
+import * as THREE from 'three';
+
+// สร้างใบหญ้า 1 กอ
+function createGrassGeometry() {
+  const positions = [];
+  const indices = [];
+
+  const bladeCount = 5;
+  const segments = 3;
+
+  for (let blade = 0; blade < bladeCount; blade++) {
+    const angle = (blade / bladeCount) * Math.PI * 2;
+    const width = 0.055 + Math.random() * 0.035;
+    const height = 0.5 + Math.random() * 0.62;
+
+    const start = positions.length / 3;
+
+    for (let segment = 0; segment <= segments; segment++) {
+      const t = segment / segments;
+      const y = height * t;
+      const bend = t * t * (0.14 + blade * 0.014);
+
+      const centerX = Math.cos(angle) * bend;
+      const centerZ = Math.sin(angle) * bend;
+
+      const halfWidth = width * (1 - t * 0.85);
+
+      positions.push(
+        centerX - Math.sin(angle) * halfWidth,
+        y,
+        centerZ - Math.cos(angle) * halfWidth
+      );
+
+      positions.push(
+        centerX + Math.sin(angle) * halfWidth,
+        y,
+        centerZ + Math.cos(angle) * halfWidth
+      );
+    }
+
+    for (let segment = 0; segment < segments; segment++) {
+      const a = start + segment * 2;
+      const b = a + 1;
+      const c = a + 2;
+      const d = a + 3;
+
+      indices.push(a, b, c, b, d, c);
+    }
+  }
+
+  const geometry = new THREE.BufferGeometry();
+
+  geometry.setAttribute(
+    'position',
+    new THREE.Float32BufferAttribute(positions, 3)
+  );
+
+  geometry.setIndex(indices);
+  geometry.computeVertexNormals();
+
+  /* Blades are lit like the ground they grow from: mostly "up" normals give
+     soft, natural gradient instead of harsh black cards when back-lit. */
+  const normals = geometry.attributes.normal;
+  for (let i = 0; i < normals.count; i++) {
+    const nx = normals.getX(i) * 0.35;
+    const ny = normals.getY(i) * 0.35 + 0.65;
+    const nz = normals.getZ(i) * 0.35;
+    const len = Math.hypot(nx, ny, nz) || 1;
+    normals.setXYZ(i, nx / len, ny / len, nz / len);
+  }
+  normals.needsUpdate = true;
+
+  return geometry;
+}
+
+// สร้างวัสดุหญ้าพร้อมระบบลม
+function createGrassMaterial() {
+  const material = new THREE.MeshStandardMaterial({
+    color: 0xffffff,
+    roughness: 0.95,
+    metalness: 0,
+    side: THREE.DoubleSide,
+    vertexColors: false
+  });
+
+  material.onBeforeCompile = (shader) => {
+    shader.uniforms.uGrassTime = {
+      value: 0
+    };
+
+    shader.vertexShader = shader.vertexShader.replace(
+      '#include <common>',
+      `#include <common>
+       uniform float uGrassTime;
+       varying float vGrassHeight;`
+    );
+
+    shader.vertexShader = shader.vertexShader.replace(
+      '#include <begin_vertex>',
+      `#include <begin_vertex>
+
+       float grassHeight = position.y;
+
+       
+       float windWave =
+         sin(uGrassTime * 1.8
+         + instanceMatrix[3][0] * 0.15
+         + instanceMatrix[3][2] * 0.15) * 0.7
+         + sin(uGrassTime * 0.9
+         + instanceMatrix[3][0] * 0.08) * 0.3;
+
+       transformed.x += windWave * grassHeight * 0.18;
+       transformed.z += windWave * grassHeight * 0.10;
+
+       vGrassHeight = clamp(grassHeight, 0.0, 1.1);
+      `
+    );
+
+    shader.fragmentShader = shader.fragmentShader.replace(
+      '#include <common>',
+      `#include <common>
+       varying float vGrassHeight;`
+    );
+
+    shader.fragmentShader = shader.fragmentShader.replace(
+      '#include <color_fragment>',
+      `#include <color_fragment>
+       float tip = smoothstep(0.0, 0.95, vGrassHeight);
+       diffuseColor.rgb *= mix(0.76, 1.14, tip);`
+    );
+
+    material.userData.shader = shader;
+  };
+
+  return material;
+}
+
+// สร้างหญ้าในแต่ละพื้นที่
+export function createGrassTile({
+  centerX,
+  centerZ,
+  tileSize,
+  count,
+  getHeight,
+  biome
+}) {
+  const geometry = createGrassGeometry();
+  const material = createGrassMaterial();
+
+  const mesh = new THREE.InstancedMesh(
+    geometry,
+    material,
+    count
+  );
+
+  const dummy = new THREE.Object3D();
+
+  const colors = biome?.colors || [
+    0x526b3c,
+    0x71834a,
+    0x3e5835
+  ];
+
+  for (let i = 0; i < count; i++) {
+    const x = centerX + (Math.random() - 0.5) * tileSize;
+    const z = centerZ + (Math.random() - 0.5) * tileSize;
+
+    const y = getHeight(x, z);
+
+    if (y === null || !Number.isFinite(y)) {
+      dummy.position.set(0, -1000, 0);
+      dummy.scale.setScalar(0);
+      dummy.updateMatrix();
+      mesh.setMatrixAt(i, dummy.matrix);
+      continue;
+    }
+
+    const scale = 0.55 + Math.random() * 0.6;
+
+    dummy.position.set(x, y, z);
+    dummy.rotation.y = Math.random() * Math.PI * 2;
+    dummy.scale.setScalar(scale);
+    dummy.updateMatrix();
+
+    mesh.setMatrixAt(i, dummy.matrix);
+
+    const color = new THREE.Color(
+      colors[Math.floor(Math.random() * colors.length)]
+    );
+    color.multiplyScalar(0.95 + Math.random() * 0.32);
+    color.offsetHSL((Math.random() - 0.5) * 0.02, 0, 0);
+
+    mesh.setColorAt(i, color);
+  }
+
+  mesh.instanceMatrix.needsUpdate = true;
+
+  if (mesh.instanceColor) {
+    mesh.instanceColor.needsUpdate = true;
+  }
+
+  mesh.computeBoundingSphere();
+
+  return mesh;
+}
+
+// อัปเดตแรงลมของหญ้า
+export function updateGrassWind(mesh, time) {
+  const shader = mesh?.material?.userData?.shader;
+
+  if (shader?.uniforms?.uGrassTime) {
+    shader.uniforms.uGrassTime.value = time;
+  }
+}
